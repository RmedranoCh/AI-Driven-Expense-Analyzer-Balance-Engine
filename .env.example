# Si no pones DATABASE_URL, usa SQLite local (data/expenses.db)
# DATABASE_URL=postgresql://usuario:pass@host:5432/invoice_engine_db

# Contraseña de administrador (déjala vacía para que ?admin=1 no pida contraseña)
# ADMIN_PASSWORD=mi_clave_admin
# Pepper para reforzar la contraseña con PBKDF2 (opcional, se genera automaticamente si vacio)
# ADMIN_PEPPER=mi_pepper_secreto

# API Key de Groq (obligatorio)
GROQ_API_KEY=tu_clave_secreta_de_groq_aqui
